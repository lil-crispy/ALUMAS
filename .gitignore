# Artefactos locales que no deben versionarse
chrome_profile/
__pycache__/
*.pyc
*.log
logs/
tmp/
*.tmp
*.temp
*.orig
*~

# Sistemas
.DS_Store
Thumbs.db
.env
.env.*
!.env.example

# Claves y certificados
*.key
*.pem
*.p12
*.pfx

# Credenciales y bases locales
credentials*
*.sqlite
*.sqlite-*
*.db

# Backups locales
*.bak
*.backup
*.backup-*

# Datos operativos que no deben versionarse
lista de usuarios.json

# Datos internos de runtime de n8n
n8n/.env
n8n/.env.*
!n8n/.env.example
n8n/.n8n/
n8n/logs/
n8n/database.sqlite
n8n/*.sqlite
n8n/*.sqlite-*
n8n/*.db
n8n/credentials*
