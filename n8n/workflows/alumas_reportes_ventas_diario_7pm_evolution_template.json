    {
      "id": "prepare-recipients",
      "name": "Preparar destinatarios reportes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        320
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const source = $input.first().json || {};\nconst token = String(source.tokenText || '').trim();\nconst reports = Array.isArray(source.reports) ? source.reports : [];\nconst recipients = Array.isArray(source.recipients) ? source.recipients : [];\nconst ferreteria = reports.find((item) => String(item.point_sale || '').toLowerCase() === 'ferreteria');\nconst bodega = reports.find((item) => String(item.point_sale || '').toLowerCase() === 'bodega');\n\nfunction normalizePhone(rawPhone) {\n  let digits = String(rawPhone || '').replace(/\\D/g, '');\n  digits = digits.replace(/^0+/, '');\n  if (digits.length === 10 && digits.startsWith('3')) digits = `57${digits}`;\n  if (digits.length === 12 && digits.startsWith('57') && digits[2] === '3') return digits;\n  return digits || null;\n}\n\nconst numbers = recipients.map(normalizePhone).filter(Boolean);\nif (!token || !ferreteria || !bodega || !numbers.length) {\n  return [{\n    json: {\n      should_send: false,\n      status: 'missing_runtime_data',\n      has_token: Boolean(token),\n      has_ferreteria_report: Boolean(ferreteria),\n      has_bodega_report: Boolean(bodega),\n      recipients_count: numbers.length,\n      report_date: source.report_date || null,\n      generated_at: source.generated_at || null\n    }\n  }];\n}\n\nreturn numbers.map((number, index) => ({\n  json: {\n    should_send: true,\n    status: 'ready_to_send',\n    recipient_index: index + 1,\n    recipient_count: numbers.length,\n    report_date: source.report_date,\n    generated_at: source.generated_at,\n    number,\n    evolution_api_key: token,\n    message_text: String(source.message_text || '').trim(),\n    ferreteria_url: ferreteria.public_url,\n    ferreteria_file_name: ferreteria.file_name || `reporte_ventas_ferreteria_${String(source.report_date || '').replace(/-/g, '')}.pdf`,\n    ferreteria_caption: 'Reporte de ventas HOY - Ferreteria',\n    bodega_url: bodega.public_url,\n    bodega_file_name: bodega.file_name || `reporte_ventas_bodega_${String(source.report_date || '').replace(/-/g, '')}.pdf`,\n    bodega_caption: 'Reporte de ventas HOY - Bodega',\n    total_general: source.total_general ?? 0\n  }\n}));"
      }
    },
    {
      "id": "should-send",
