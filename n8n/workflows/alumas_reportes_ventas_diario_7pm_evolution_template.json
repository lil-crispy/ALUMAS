              "responseFormat": "json"
            }
          }
        }
      }
    },
    {
      "id": "merge-runtime",
      "name": "Combinar token y reportes",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        1040,
        320
      ],
      "parameters": {
        "mode": "combine",
        "combineBy": "combineByPosition",
        "numberInputs": 2,
        "options": {}
      }
