{
  "name": "ALUMAS - Reportes cierre mensual y anual 7PM Evolution",
  "active": true,
  "settings": {
    "timezone": "America/Bogota",
    "executionOrder": "v1"
  },
  "nodes": [
    {
      "id": "manual-trigger",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        220,
        420
      ],
      "parameters": {}
    },
    {
      "id": "schedule-trigger",
      "name": "Schedule Trigger 7PM diario",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        220,
        220
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 19 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "build-manual-context",
      "name": "Construir contexto prueba manual",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        420
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const now = $now.setZone('America/Bogota');\nreturn [{\n  json: {\n    date: now.toISODate(),\n    force_monthly: true,\n    force_annual: true,\n    execution_mode: 'manual_test'\n  }\n}];"
      }
    },
    {
      "id": "build-scheduled-context",
      "name": "Construir contexto programado",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        220
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const now = $now.setZone('America/Bogota');\nreturn [{\n  json: {\n    date: now.toISODate(),\n    force_monthly: false,\n    force_annual: false,\n    execution_mode: 'scheduled'\n  }\n}];"
      }
    },
    {
      "id": "read-token",
      "name": "Leer token Evolution",
      "type": "n8n-nodes-base.readBinaryFile",
      "typeVersion": 1,
      "position": [
        780,
        140
      ],
      "parameters": {
        "filePath": "/data/alumas_runtime/evolution_instance_token.txt",
        "dataPropertyName": "tokenBinary"
      }
    },
    {
      "id": "extract-token",
      "name": "Extraer token texto",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1.1,
      "position": [
        1040,
        140
      ],
      "parameters": {
        "operation": "text",
        "binaryPropertyName": "tokenBinary",
        "destinationKey": "tokenText",
        "options": {
          "keepSource": "json"
        }
      }
    },
    {
      "id": "generate-closures",
      "name": "Generar cierre mensual y anual",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        780,
        320
      ],
      "parameters": {
        "method": "POST",
        "url": "http://status_generator:8000/generate-sales-closing-summary",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ ({\n  date: $json.date,\n  force_monthly: $json.force_monthly,\n  force_annual: $json.force_annual,\n  execution_mode: $json.execution_mode,\n  output_subdir: 'sales_closing_' + String($json.date || '').replace(/-/g, '') + '_' + String($json.execution_mode || 'scheduled')\n}) }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": false,
              "neverError": false,
              "responseFormat": "json"
            }
          }
        }
      }
    },
    {
      "id": "merge-runtime",
      "name": "Combinar token y cierre",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        1320,
        240
      ],
      "parameters": {
        "mode": "combine",
        "combineBy": "combineByPosition",
        "numberInputs": 2,
        "options": {}
      }
    },
    {
      "id": "prepare-deliveries",
      "name": "Preparar entregas cierre",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1600,
        240
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const source = $input.first().json || {};\nconst token = String(source.tokenText || '').trim();\nconst deliveries = Array.isArray(source.deliveries) ? source.deliveries.slice().sort((a, b) => (a.order || 0) - (b.order || 0)) : [];\nconst recipients = Array.isArray(source.recipients) ? source.recipients : [];\n\nfunction normalizePhone(rawPhone) {\n  let digits = String(rawPhone || '').replace(/\\D/g, '');\n  digits = digits.replace(/^0+/, '');\n  if (digits.length === 10 && digits.startsWith('3')) digits = `57${digits}`;\n  if (digits.length === 12 && digits.startsWith('57') && digits[2] === '3') return digits;\n  return digits || null;\n}\n\nconst numbers = recipients.map(normalizePhone).filter(Boolean);\nif (!token || !numbers.length || !deliveries.length) {\n  return [{\n    json: {\n      should_send: false,\n      status: 'nothing_to_send',\n      has_token: Boolean(token),\n      recipients_count: numbers.length,\n      deliveries_count: deliveries.length,\n      reference_date: source.reference_date || null,\n      monthly_due: Boolean(source.monthly_due),\n      annual_due: Boolean(source.annual_due),\n      execution_mode: source.execution_mode || 'scheduled'\n    }\n  }];\n}\n\nconst items = [];\nfor (const number of numbers) {\n  for (const delivery of deliveries) {\n    items.push({\n      json: {\n        should_send: true,\n        number,\n        evolution_api_key: token,\n        delivery_type: delivery.type,\n        media_url: delivery.media_url || null,\n        file_name: delivery.file_name || null,\n        mime_type: delivery.mime_type || null,\n        caption: delivery.caption || '',\n        text: delivery.text || '',\n        campaign: delivery.campaign || '',\n        order: delivery.order || 0,\n        reference_date: source.reference_date || null,\n        monthly_due: Boolean(source.monthly_due),\n        annual_due: Boolean(source.annual_due),\n        execution_mode: source.execution_mode || 'scheduled'\n      }\n    });\n  }\n}\nreturn items;"
      }
    },
    {
      "id": "should-send",
      "name": "¿Hay entregas para enviar?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1880,
        240
      ],
      "parameters": {
        "conditions": {
          "combinator": "and",
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.should_send }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        }
      }
    },
    {
      "id": "is-media",
      "name": "¿Entrega multimedia?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        2160,
        240
      ],
      "parameters": {
        "conditions": {
          "combinator": "and",
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.delivery_type }}",
              "rightValue": "image",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        }
      }
    },
    {
      "id": "send-media",
      "name": "Enviar grafico por Evolution",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        2440,
        160
      ],
      "parameters": {
        "method": "POST",
        "url": "http://evolution_api:8080/message/sendMedia/alumas",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $json.evolution_api_key }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "keypair",
        "bodyParameters": {
          "parameters": [
            {
              "name": "number",
              "value": "={{ $json.number }}"
            },
            {
              "name": "mediatype",
              "value": "image"
            },
            {
              "name": "mimetype",
              "value": "={{ $json.mime_type || 'image/png' }}"
            },
            {
              "name": "media",
              "value": "={{ $json.media_url }}"
            },
            {
              "name": "fileName",
              "value": "={{ $json.file_name }}"
            },
            {
              "name": "caption",
              "value": "={{ $json.caption }}"
            }
          ]
        },
        "options": {
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 1500
            }
          },
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": false,
              "responseFormat": "json"
            }
          }
        }
      }
    },
    {
      "id": "send-text",
      "name": "Enviar texto por Evolution",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        2440,
        320
      ],
      "parameters": {
        "method": "POST",
        "url": "http://evolution_api:8080/message/sendText/alumas",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $json.evolution_api_key }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "keypair",
        "bodyParameters": {
          "parameters": [
            {
              "name": "number",
              "value": "={{ $json.number }}"
            },
            {
              "name": "text",
              "value": "={{ $json.text }}"
            }
          ]
        },
        "options": {
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 1200
            }
          },
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": false,
              "responseFormat": "json"
            }
          }
        }
      }
    },
    {
      "id": "no-deliveries",
      "name": "Sin entregas programadas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2160,
